                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "20000000-0000-4000-8000-000000000001",
                    "leftValue": "={{ $json.answers.category.choice }}",
                    "rightValue": "Clients",
                    "operator": {
