    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.jevEndpoint }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"state\": {\n    \"sender\": {{ $json.sender.toJsonString() }},\n    \"subject\": {{ $json.subject.toJsonString() }},\n    \"body\": {{ $json.body.slice(0, 1500).toJsonString() }}\n  },\n  \"model\": {{ $json.jevModel.toJsonString() }},\n  \"questions\": {\n    \"category\": {\n      \"type\": \"choice\",\n      \"instructions\": \"Classify the primary purpose of this email.\",\n      \"criteria\": {\n        \"Clients\": \"A message from or about a client, lead, project, or business relationship.\",\n        \"Receipts\": \"A purchase receipt, invoice, billing confirmation, or transaction record.\",\n        \"Newsletters\": \"A bulk newsletter, marketing update, promotion, or recurring publication.\",\n        \"Personal\": \"A personal message that does not belong in the other categories.\"\n      }\n    },\n    \"urgency\": {\n      \"type\": \"score\",\n      \"instructions\": \"Rate how urgently the recipient should respond.\",\n      \"criteria\": [\n        \"Low: informational or no response needed.\",\n        \"Medium: a response is useful but not time-critical.\",\n        \"High: time-sensitive, blocking, or requires prompt attention.\"\n      ]\n    },\n    \"real_person\": {\n      \"type\": \"noul\",\n      \"instructions\": \"Was this message written by a real person expecting an individual response?\"\n    }\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        260
      ],
      "id": "4f916395-605b-42c1-ae88-a526ec4979aa",
